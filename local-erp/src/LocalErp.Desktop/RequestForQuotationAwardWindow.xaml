<Window x:Class="LocalErp.Desktop.RequestForQuotationAwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjudicação de cotação"
        Width="1080"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Loaded="Window_Loaded">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="24,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Decisão de adjudicação"
                     FontSize="25"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="Escolha manualmente uma oferta finalizada por linha. Linhas podem permanecer sem adjudicação e nenhum Pedido de Compra é criado nesta etapa."
                     Margin="0,6,20,0"
                     Foreground="{StaticResource Brush.Muted}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
          <TextBlock x:Name="DecisionStatusText"
                     Text="Carregando..."
                     FontWeight="SemiBold"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource Brush.Text}" />
          <TextBlock x:Name="DecisionSummaryText"
                     Margin="0,5,0,0"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource Brush.Muted}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="24,16,24,0"
            Padding="12,9"
            Background="#EEF5FC"
            BorderBrush="#C8DDF4"
            BorderThickness="1"
            CornerRadius="5">
      <TextBlock Text="A tela não ranqueia propostas, não converte moedas e não recomenda fornecedor. A decisão é registrada exatamente como selecionada pelo usuário."
                 Foreground="{StaticResource Brush.Text}"
                 TextWrapping="Wrap" />
    </Border>

    <StackPanel Grid.Row="2" Margin="24,12,24,0">
      <Border x:Name="StatusPanel"
              Padding="12,9"
              Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1"
              CornerRadius="5">
        <TextBlock x:Name="StatusText"
                   Text="Carregando adjudicação..."
                   Foreground="{StaticResource Brush.Muted}" />
      </Border>
      <Border x:Name="ErrorPanel"
              Margin="0,8,0,0"
              Padding="12,9"
              Background="#FFF4F2"
              BorderBrush="#E7C6C0"
              BorderThickness="1"
              CornerRadius="5"
              Visibility="Collapsed">
        <TextBlock x:Name="ErrorText"
                   Foreground="{StaticResource Brush.Text}"
                   TextWrapping="Wrap" />
      </Border>
      <Border x:Name="SuccessPanel"
              Margin="0,8,0,0"
              Padding="12,9"
              Background="#E9F6EF"
              BorderBrush="#BFDCCB"
              BorderThickness="1"
              CornerRadius="5"
              Visibility="Collapsed">
        <TextBlock x:Name="SuccessText"
                   Foreground="{StaticResource Brush.Text}"
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <ScrollViewer x:Name="AwardContent"
                  Grid.Row="3"
                  Margin="24,14,24,16"
                  VerticalScrollBarVisibility="Auto"
                  Visibility="Collapsed">
      <StackPanel>
        <Border Padding="14"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Observação da decisão"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBox x:Name="NotesTextBox"
                     Margin="0,7,0,0"
                     MinHeight="64"
                     MaxLength="1000"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Padding="7,5" />
            <Button x:Name="SaveNotesButton"
                    Content="Salvar observação"
                    Click="SaveNotes_Click"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    MinWidth="125"
                    Padding="12,6"
                    Cursor="Hand" />
          </StackPanel>
        </Border>

        <TextBlock Text="Adjudicação por linha"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.Text}" />
        <TextBlock Text="Somente respostas finalizadas e cotadas para a própria linha aparecem como opção."
                   Margin="0,5,0,10"
                   Foreground="{StaticResource Brush.Muted}" />

        <ItemsControl x:Name="AwardLinesItemsControl">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8"
                      Padding="14"
                      Background="{StaticResource Brush.Surface}"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1"
                      CornerRadius="6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding QuantityDisplay}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding NeededByDisplay}"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource Brush.Muted}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Oferta selecionada"
                               Foreground="{StaticResource Brush.Muted}" />
                    <ComboBox ItemsSource="{Binding Options}"
                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                              DisplayMemberPath="Display"
                              SelectionChanged="AwardSelection_Changed"
                              IsEnabled="{Binding CanEdit}"
                              Margin="0,5,0,0"
                              MinHeight="32"
                              Padding="7,4" />
                    <TextBlock Text="{Binding OfferHint}"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource Brush.Muted}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="4"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="24,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="StartAwardButton"
                Content="Iniciar adjudicação"
                Click="StartAward_Click"
                MinWidth="130"
                Padding="14,7"
                Margin="0,0,8,0"
                Cursor="Hand" />
        <Button x:Name="FinalizeButton"
                Content="Finalizar decisão"
                Click="Finalize_Click"
                MinWidth="120"
                Padding="14,7"
                Margin="0,0,8,0"
                Cursor="Hand" />
        <Button Content="Fechar"
                Click="Close_Click"
                MinWidth="88"
                Padding="14,7"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                Cursor="Hand" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
