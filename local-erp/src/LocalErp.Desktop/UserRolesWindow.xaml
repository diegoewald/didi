<Window x:Class="LocalErp.Desktop.UserRolesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar roles — Local ERP"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Loaded="Window_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock x:Name="TargetTitle" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
      <TextBlock x:Name="TargetSubtitle" Margin="0,6,0,0" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,0,0,14" Padding="12,10" Background="#EEF5FC"
            BorderBrush="#C8DDF4" BorderThickness="1" CornerRadius="5">
      <TextBlock Text="Proteção administrativa: o ERP impede remover a associação que eliminaria o último usuário ativo com capacidade efetiva de administrar roles."
                 Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" />
    </Border>

    <StackPanel Grid.Row="2">
      <Border x:Name="ErrorPanel" Margin="0,0,0,12" Padding="12,9" Background="#FFF4F2"
              BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
      </Border>
      <Border x:Name="SuccessPanel" Margin="0,0,0,12" Padding="12,9" Background="#E9F6EF"
              BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
        <TextBlock x:Name="SuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="3">
      <Border x:Name="LoadingPanel" Padding="24" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <TextBlock Text="Carregando roles..." HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource Brush.Text}" />
      </Border>

      <Border x:Name="EmptyPanel" Padding="24" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Nenhuma role cadastrada" FontWeight="SemiBold" FontSize="16"
                     HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="A administração de roles/permissões será ampliada em uma etapa própria."
                     Margin="0,6,0,0" Foreground="{StaticResource Brush.Muted}" />
        </StackPanel>
      </Border>

      <Border x:Name="RolesPanel" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
        <DataGrid x:Name="RolesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0"
                  Background="Transparent" AlternatingRowBackground="#F8FAFC"
                  HorizontalGridLinesBrush="{StaticResource Brush.Border}" VerticalGridLinesBrush="Transparent">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="*" MinWidth="220" />
            <DataGridTextColumn Header="Status" Binding="{Binding RoleStatus}" Width="110" />
            <DataGridTextColumn Header="Associação" Binding="{Binding AssignmentStatus}" Width="130" />
            <DataGridTemplateColumn Header="Ação" Width="125">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="{Binding ActionLabel}"
                          IsEnabled="{Binding CanChange}"
                          Click="ToggleAssignment_Click"
                          Padding="11,5"
                          MinWidth="88"
                          Background="{StaticResource Brush.Surface}"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1"
                          Foreground="{StaticResource Brush.Text}"
                          Cursor="Hand" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>

    <Grid Grid.Row="4" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Roles inativas podem ser removidas, mas não atribuídas. Usuários inativos também não recebem novas roles."
                 VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,18,0" />
      <Button x:Name="CloseButton" Grid.Column="1" Content="Fechar" Click="Close_Click"
              MinWidth="92" Padding="14,7" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
              Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
    </Grid>
  </Grid>
</Window>
