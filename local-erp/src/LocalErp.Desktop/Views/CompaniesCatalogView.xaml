<UserControl x:Class="LocalErp.Desktop.Views.CompaniesCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,26" MaxWidth="1120" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Empresas" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="Cadastro base de empresas do ERP. Consulte ativas e inativas, crie registros, renomeie e controle o status."
                     Foreground="{StaticResource Brush.Muted}" Margin="0,7,0,0" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="Atualizar" Click="Refresh_Click" Padding="14,7" MinWidth="90"
                VerticalAlignment="Top" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
      </Grid>

      <Border Grid.Row="1" Margin="0,0,0,18" Padding="16" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="Nova empresa" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="O nome é validado na camada de domínio e pode ter até 200 caracteres."
                     Margin="0,4,0,14" Foreground="{StaticResource Brush.Muted}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="420" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="Nome" Margin="0,0,0,5" Foreground="{StaticResource Brush.Muted}" />
              <TextBox x:Name="CreateNameTextBox" MaxLength="200" MinHeight="32" Padding="8,5"
                       KeyDown="CreateNameTextBox_KeyDown" />
            </StackPanel>
            <Button x:Name="CreateCompanyButton" Grid.Column="1" Content="Criar empresa" Click="CreateCompany_Click"
                    MinWidth="116" MinHeight="32" Padding="14,6" Margin="0,22,0,0" VerticalAlignment="Top" Cursor="Hand" />
          </Grid>
          <Border x:Name="CreateErrorPanel" Margin="0,12,0,0" Padding="12,9" Background="#FFF4F2"
                  BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
            <TextBlock x:Name="CreateErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
          </Border>
          <Border x:Name="CreateSuccessPanel" Margin="0,12,0,0" Padding="12,9" Background="#E9F6EF"
                  BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
            <TextBlock x:Name="CreateSuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Margin="0,0,0,12" Padding="14,11" Background="#EEF5FC" BorderBrush="#C8DDF4"
              BorderThickness="1" CornerRadius="5" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="Carregando empresas..." Foreground="{StaticResource Brush.Text}" />
      </Border>

      <StackPanel Grid.Row="3">
        <Border Margin="0,0,0,12" Padding="14,11" Background="#FFF4F2" BorderBrush="#E7C6C0"
                BorderThickness="1" CornerRadius="5" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border x:Name="MutationErrorPanel" Margin="0,0,0,12" Padding="12,9" Background="#FFF4F2"
                BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="MutationErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border x:Name="MutationSuccessPanel" Margin="0,0,0,12" Padding="12,9" Background="#E9F6EF"
                BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="MutationSuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
      </StackPanel>

      <Border x:Name="RenamePanel" Grid.Row="4" Margin="0,0,0,18" Padding="16" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="RenameTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="420" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RenameTextBox" Grid.Column="0" MaxLength="200" MinHeight="32" Padding="8,5"
                     Margin="0,0,12,0" KeyDown="RenameTextBox_KeyDown" />
            <Button x:Name="RenameSaveButton" Grid.Column="1" Content="Salvar" Click="RenameSave_Click"
                    MinWidth="88" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" />
            <Button x:Name="RenameCancelButton" Grid.Column="2" Content="Cancelar" Click="RenameCancel_Click"
                    MinWidth="88" Padding="14,6" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid Grid.Row="5">
        <Border Padding="28" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="6" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Nenhuma empresa encontrada" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Use o formulário acima para cadastrar a primeira empresa." Margin="0,6,0,0"
                       HorizontalAlignment="Center" Foreground="{StaticResource Brush.Muted}" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="6" Visibility="{Binding HasCompanies, Converter={StaticResource BoolToVisibilityConverter}}">
          <DataGrid ItemsSource="{Binding Companies}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    BorderThickness="0" RowHeaderWidth="0" MinHeight="220" MaxHeight="520" SelectionMode="Single"
                    Background="Transparent" AlternatingRowBackground="#F8FAFC" HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                    VerticalGridLinesBrush="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Empresa" Binding="{Binding Name}" Width="*" MinWidth="300" />
              <DataGridTemplateColumn Header="Status" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Padding="9,3" CornerRadius="10" HorizontalAlignment="Left">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#E9F6EF" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                              <Setter Property="Background" Value="#EEF1F4" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Nome" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Renomear" Click="OpenRename_Click" Padding="11,5" MinWidth="88"
                            Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Situação" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="{Binding StatusAction}" Click="ToggleStatus_Click" Padding="11,5" MinWidth="88"
                            Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
