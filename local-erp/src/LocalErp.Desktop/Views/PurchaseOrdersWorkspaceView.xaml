<UserControl x:Class="LocalErp.Desktop.Views.PurchaseOrdersWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid x:Name="WorkspaceContent" Margin="28,26" MaxWidth="1180" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Pedidos de compra" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="Documentos gerados exclusivamente a partir de adjudicações finalizadas, com termos preservados por snapshot."
                     Foreground="{StaticResource Brush.Muted}" Margin="0,7,0,0" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Atualizar" Click="Refresh_Click" Padding="14,7" MinWidth="90"
                  Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                  BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
          <Button Content="Novo pedido" Click="OpenCreation_Click" Padding="14,7" MinWidth="110" Margin="8,0,0,0" Cursor="Hand" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Margin="0,0,0,16" Padding="14" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Status" VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" Margin="0,0,10,0" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label"
                    SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                    SelectionChanged="StatusFilter_SelectionChanged" MinHeight="31" Padding="7,4" />
          <TextBlock Grid.Column="2" Text="Numeração interna sequencial no formato PC-000001. Emissão não representa envio eletrônico ao fornecedor."
                     Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="2">
        <Border Margin="0,0,0,12" Padding="14,11" Background="#EEF5FC" BorderBrush="#C8DDF4"
                BorderThickness="1" CornerRadius="5" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="Carregando pedidos de compra..." Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border Margin="0,0,0,12" Padding="14,11" Background="#FFF4F2" BorderBrush="#E7C6C0"
                BorderThickness="1" CornerRadius="5" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border x:Name="OperationErrorPanel" Margin="0,0,0,12" Padding="12,9" Background="#FFF4F2"
                BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="OperationErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border x:Name="OperationSuccessPanel" Margin="0,0,0,12" Padding="12,9" Background="#E9F6EF"
                BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="OperationSuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
      </StackPanel>

      <Grid Grid.Row="3" Margin="0,0,0,20">
        <Border Padding="28" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="6" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Nenhum pedido encontrado" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Crie um pedido a partir de uma adjudicação finalizada ou altere o filtro de status."
                       Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Muted}" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="6" Visibility="{Binding HasPurchaseOrders, Converter={StaticResource BoolToVisibilityConverter}}">
          <DataGrid ItemsSource="{Binding PurchaseOrders}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    BorderThickness="0" RowHeaderWidth="0" MinHeight="180" MaxHeight="310" SelectionMode="Single"
                    Background="Transparent" AlternatingRowBackground="#F8FAFC" HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                    VerticalGridLinesBrush="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Pedido" Binding="{Binding NumberDisplay}" Width="105" />
              <DataGridTextColumn Header="Fornecedor" Binding="{Binding SupplierName}" Width="*" MinWidth="220" />
              <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100" />
              <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="130" />
              <DataGridTextColumn Header="Criado em" Binding="{Binding CreatedDisplay}" Width="145" />
              <DataGridTemplateColumn Header="Ação" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Abrir" Click="OpenOrder_Click" Padding="10,5" MinWidth="66"
                            Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="4">
        <Border x:Name="CreationPanel" Padding="16" Margin="0,0,0,18" Background="#F7F9FB"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Criar a partir de adjudicação finalizada" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                <TextBlock Text="A lista contém somente fornecedores ativos com linhas adjudicadas que ainda não possuem pedido. Quantidades, preços, moeda e datas são reconstruídos pela Application."
                           Margin="0,5,20,0" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="Fechar" Click="CloseCreation_Click" Padding="12,6" MinWidth="75"
                      Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Cursor="Hand" />
            </Grid>
            <TextBlock x:Name="CreationEmptyText" Text="Não há adjudicações elegíveis para gerar novos pedidos neste momento."
                       Margin="0,14,0,0" Foreground="{StaticResource Brush.Muted}" Visibility="Collapsed" />
            <Border x:Name="CreationGridBorder" Margin="0,14,0,0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5">
              <DataGrid ItemsSource="{Binding CreationCandidates}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                        RowHeaderWidth="0" MinHeight="120" MaxHeight="260" Background="Transparent"
                        HorizontalGridLinesBrush="{StaticResource Brush.Border}" VerticalGridLinesBrush="Transparent">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Fornecedor" Binding="{Binding SupplierName}" Width="*" MinWidth="220" />
                  <DataGridTextColumn Header="Origem" Binding="{Binding RequestForQuotationDisplay}" Width="120" />
                  <DataGridTextColumn Header="Linhas" Binding="{Binding AwardedLinesDisplay}" Width="160" />
                  <DataGridTextColumn Header="Adjudicada em" Binding="{Binding AwardFinalizedDisplay}" Width="145" />
                  <DataGridTemplateColumn Header="Ação" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Criar pedido" Click="CreateCandidate_Click" Padding="9,5" MinWidth="88" Cursor="Hand" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </StackPanel>
        </Border>

        <Border Padding="18" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="6"
                Visibility="{Binding HasCurrentPurchaseOrder, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding CurrentNumberDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                <TextBlock Text="{Binding CurrentSupplierDisplay}" FontSize="15" Margin="0,4,0,0" Foreground="{StaticResource Brush.Text}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock Text="Status: " Foreground="{StaticResource Brush.Muted}" />
                  <TextBlock Text="{Binding CurrentStatusLabel}" FontWeight="SemiBold" />
                  <TextBlock Text="   Criado em: " Foreground="{StaticResource Brush.Muted}" />
                  <TextBlock Text="{Binding CurrentCreatedDisplay}" />
                  <TextBlock Text="   Total: " Foreground="{StaticResource Brush.Muted}" />
                  <TextBlock Text="{Binding CurrentTotalDisplay}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="Adjudicação: " FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Brush.Muted}" />
                  <TextBlock Text="{Binding CurrentAwardIdDisplay}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Brush.Muted}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Emitir" Click="Issue_Click" Padding="14,7" MinWidth="90" Margin="0,0,8,0" Cursor="Hand"
                        Visibility="{Binding CanIssue, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Cancelar pedido" Click="OpenCancel_Click" Padding="14,7" MinWidth="125" Cursor="Hand"
                        Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
              </StackPanel>
            </Grid>

            <Border Margin="0,0,0,16" Padding="12,9" Background="#EEF5FC" BorderBrush="#C8DDF4" BorderThickness="1" CornerRadius="5">
              <TextBlock Text="Emitir altera apenas o estado interno do documento para Emitido. Este slice não envia e-mail, EDI, API nem qualquer comunicação eletrônica ao fornecedor."
                         TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
            </Border>

            <TextBlock Text="Observação" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,5" />
            <TextBox x:Name="NotesTextBox" Text="{Binding CurrentPurchaseOrder.Notes, Mode=OneWay}" MaxLength="1000" MinHeight="62"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8,6"
                     IsReadOnly="{Binding IsReadOnly}" />
            <Button Content="Salvar observação" Click="SaveNotes_Click" Padding="12,6" MinWidth="120" HorizontalAlignment="Left"
                    Margin="0,9,0,18" Cursor="Hand" Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Grid Margin="0,0,0,9">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Linhas do pedido" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
              <TextBlock Grid.Column="1" Text="Termos imutáveis da adjudicação" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" />
            </Grid>
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,16">
              <DataGrid ItemsSource="{Binding CurrentLines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        BorderThickness="0" RowHeaderWidth="0" MinHeight="120" MaxHeight="310" Background="Transparent"
                        HorizontalGridLinesBrush="{StaticResource Brush.Border}" VerticalGridLinesBrush="Transparent">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="42" />
                  <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" MinWidth="210" />
                  <DataGridTextColumn Header="Qtd." Binding="{Binding QuantityDisplay}" Width="75" />
                  <DataGridTextColumn Header="Unidade" Binding="{Binding MeasurementUnitName}" Width="110" />
                  <DataGridTextColumn Header="Preço unit." Binding="{Binding UnitPriceDisplay}" Width="130" />
                  <DataGridTextColumn Header="Total" Binding="{Binding LineTotalDisplay}" Width="130" />
                  <DataGridTextColumn Header="Entrega prometida" Binding="{Binding PromisedDeliveryDateDisplay}" Width="125" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <Border x:Name="CancellationPanel" Padding="14" Margin="0,0,0,14" Background="#FFF8F1"
                    BorderBrush="#E8D3B6" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Cancelar pedido" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                <TextBlock Text="O cancelamento preserva o documento e seu histórico. Informe uma justificativa."
                           Margin="0,4,0,10" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
                <TextBox x:Name="CancellationReasonTextBox" MaxLength="500" MinHeight="56" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="Confirmar cancelamento" Click="ConfirmCancel_Click" Padding="12,6" MinWidth="150" Cursor="Hand" />
                  <Button Content="Fechar" Click="CloseCancel_Click" Padding="12,6" MinWidth="75" Margin="8,0,0,0"
                          Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Cursor="Hand" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Padding="12,10" Background="#F7F9FB" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5"
                    Visibility="{Binding HasIssuedHistory, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Emitido em: " Foreground="{StaticResource Brush.Muted}" />
                <TextBlock Text="{Binding CurrentIssuedDisplay}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Padding="12,10" Background="#F7F9FB" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5"
                    Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Cancelado em: " Foreground="{StaticResource Brush.Muted}" />
                  <TextBlock Text="{Binding CurrentCancelledDisplay}" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentCancellationReasonDisplay}" Margin="0,5,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
