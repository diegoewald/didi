<UserControl x:Class="LocalErp.Desktop.Views.RequestForQuotationsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid x:Name="WorkspaceContent" Margin="28,26" MaxWidth="1180" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Cotações / RFQ" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="Segundo fluxo de Compras: origem em solicitação enviada, fornecedores convidados e respostas comerciais registradas."
                     Foreground="{StaticResource Brush.Muted}" Margin="0,7,0,0" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Atualizar" Click="Refresh_Click" Padding="14,7" MinWidth="90"
                  Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                  BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
          <Button Content="Nova cotação" Click="OpenCreate_Click" Padding="14,7" MinWidth="115" Margin="8,0,0,0" Cursor="Hand" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Margin="0,0,0,16" Padding="14" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Status" VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" Margin="0,0,10,0" />
          <ComboBox x:Name="StatusFilterComboBox" Grid.Column="1" ItemsSource="{Binding StatusFilters}"
                    DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                    SelectionChanged="StatusFilter_SelectionChanged" MinHeight="31" Padding="7,4" />
          <TextBlock Grid.Column="2" Text="Este slice não escolhe vencedor e não cria Pedido de Compra."
                     Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="2">
        <Border Margin="0,0,0,12" Padding="14,11" Background="#EEF5FC" BorderBrush="#C8DDF4"
                BorderThickness="1" CornerRadius="5" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="Carregando cotações/RFQs..." Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border Margin="0,0,0,12" Padding="14,11" Background="#FFF4F2" BorderBrush="#E7C6C0"
                BorderThickness="1" CornerRadius="5" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border x:Name="OperationErrorPanel" Margin="0,0,0,12" Padding="12,9" Background="#FFF4F2"
                BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="OperationErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border x:Name="OperationSuccessPanel" Margin="0,0,0,12" Padding="12,9" Background="#E9F6EF"
                BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="OperationSuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
      </StackPanel>

      <Grid Grid.Row="3" Margin="0,0,0,20">
        <Border Padding="28" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="6" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Nenhuma cotação encontrada" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Crie uma cotação a partir de uma solicitação enviada ou altere o filtro."
                       Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Muted}" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="6" Visibility="{Binding HasRequestsForQuotation, Converter={StaticResource BoolToVisibilityConverter}}">
          <DataGrid ItemsSource="{Binding RequestsForQuotation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    BorderThickness="0" RowHeaderWidth="0" MinHeight="180" MaxHeight="300" SelectionMode="Single"
                    Background="Transparent" AlternatingRowBackground="#F8FAFC" HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                    VerticalGridLinesBrush="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Criada em" Binding="{Binding CreatedDisplay}" Width="145" />
              <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="105" />
              <DataGridTextColumn Header="Linhas" Binding="{Binding LineCount}" Width="65" />
              <DataGridTextColumn Header="Fornec." Binding="{Binding SupplierCount}" Width="70" />
              <DataGridTextColumn Header="Respostas" Binding="{Binding ResponseCount}" Width="75" />
              <DataGridTextColumn Header="Observação" Binding="{Binding NotesDisplay}" Width="*" MinWidth="220" />
              <DataGridTemplateColumn Header="Ação" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Abrir" Click="OpenRfq_Click" Padding="10,5" MinWidth="66" Cursor="Hand"
                            Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="4">
        <Border x:Name="CreationPanel" Padding="16" Margin="0,0,0,16" Background="#F7F9FB"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Nova cotação" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Selecione uma Solicitação de Compra enviada. Linhas e fornecedores serão escolhidos depois da criação do rascunho."
                       Margin="0,5,0,10" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
            <ComboBox x:Name="CreationSourceComboBox" ItemsSource="{Binding CreationSources}" DisplayMemberPath="Display"
                      SelectedValuePath="Id" MinHeight="32" Padding="7,4" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Criar rascunho" Click="Create_Click" Padding="12,6" MinWidth="110" Cursor="Hand" />
              <Button Content="Fechar" Click="CloseCreate_Click" Padding="12,6" MinWidth="75" Margin="8,0,0,0"
                      Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Cursor="Hand" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Padding="18" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="6" Visibility="{Binding HasCurrentRequestForQuotation, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Cotação selecionada" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock Text="Status: " Foreground="{StaticResource Brush.Muted}" />
                  <TextBlock Text="{Binding CurrentStatusLabel}" FontWeight="SemiBold" />
                  <TextBlock Text="   Criada em: " Foreground="{StaticResource Brush.Muted}" />
                  <TextBlock Text="{Binding CurrentCreatedDisplay}" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentSourceRequestDisplay, StringFormat=Origem: {0}}" Margin="0,4,0,0" Foreground="{StaticResource Brush.Muted}" />
                <TextBlock Text="{Binding CurrentIdDisplay, StringFormat=ID técnico: {0}}" Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Brush.Muted}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Enviar RFQ" Click="Send_Click" Padding="12,7" MinWidth="95" Margin="0,0,8,0" Cursor="Hand"
                        Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Encerrar" Click="CloseRfq_Click" Padding="12,7" MinWidth="88" Margin="0,0,8,0" Cursor="Hand"
                        Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Cancelar" Click="OpenCancel_Click" Padding="12,7" MinWidth="88" Cursor="Hand"
                        Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
              </StackPanel>
            </Grid>

            <Border Margin="0,0,0,14" Padding="12,9" Background="#EEF5FC" BorderBrush="#C8DDF4" BorderThickness="1" CornerRadius="5"
                    Visibility="{Binding IsStructureReadOnly, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="Após o envio, linhas e fornecedores ficam imutáveis. Em status Enviada ainda é possível registrar/finalizar respostas e encerrar ou cancelar o RFQ."
                         TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="Observação" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
            <TextBox x:Name="NotesTextBox" Text="{Binding CurrentRequestForQuotation.Notes, Mode=OneWay}" MaxLength="1000"
                     MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" Padding="7,5" IsReadOnly="{Binding IsStructureReadOnly}" />
            <Button Content="Salvar observação" Click="SaveNotes_Click" Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,18"
                    Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibilityConverter}}" Cursor="Hand" />

            <TextBlock Text="Linhas da cotação" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5">
              <DataGrid ItemsSource="{Binding CurrentSourceLines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        CanUserDeleteRows="False" RowHeaderWidth="0" BorderThickness="0" MinHeight="110" MaxHeight="260"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Brush.Border}" VerticalGridLinesBrush="Transparent">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="45" />
                  <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" MinWidth="230" />
                  <DataGridTextColumn Header="Quantidade" Binding="{Binding QuantityDisplay}" Width="90" />
                  <DataGridTextColumn Header="Unidade" Binding="{Binding MeasurementUnitName}" Width="120" />
                  <DataGridTextColumn Header="Necessidade" Binding="{Binding NeededByDateDisplay}" Width="105" />
                  <DataGridTemplateColumn Header="Remover" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Remover" Click="RemoveSourceLine_Click" Padding="7,4" MinWidth="62" Cursor="Hand"
                                Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                Visibility="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,18" Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibilityConverter}}">
              <ComboBox x:Name="AvailableSourceLineComboBox" ItemsSource="{Binding AvailableSourceLines}" DisplayMemberPath="SelectionDisplay"
                        MinWidth="520" MinHeight="31" Padding="7,4" />
              <Button Content="Adicionar linha" Click="AddSourceLine_Click" Padding="12,6" Margin="8,0,0,0" Cursor="Hand" />
            </StackPanel>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Fornecedores convidados" FontSize="17" FontWeight="SemiBold" />
              <Button Grid.Column="1" Content="Adicionar fornecedor" Click="OpenSupplierPicker_Click" Padding="12,6" Cursor="Hand"
                      Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10">
              <DataGrid ItemsSource="{Binding CurrentSuppliers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        CanUserDeleteRows="False" RowHeaderWidth="0" BorderThickness="0" MinHeight="105" MaxHeight="250"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Brush.Border}" VerticalGridLinesBrush="Transparent">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Fornecedor" Binding="{Binding Name}" Width="*" MinWidth="220" />
                  <DataGridTextColumn Header="Cadastro" Binding="{Binding ActiveLabel}" Width="90" />
                  <DataGridTextColumn Header="Resposta" Binding="{Binding ResponseStatusLabel}" Width="110" />
                  <DataGridTemplateColumn Header="Resposta" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Criar" Click="OpenCreateQuotation_Click" Padding="7,4" Margin="0,0,4,0" Cursor="Hand"
                                  Visibility="{Binding CanCreateResponse, Converter={StaticResource BoolToVisibilityConverter}}" />
                          <Button Content="Abrir" Click="OpenQuotation_Click" Padding="7,4" Cursor="Hand"
                                  Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                  Visibility="{Binding HasResponse, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Remover" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Remover" Click="RemoveSupplier_Click" Padding="7,4" Cursor="Hand"
                                Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                Visibility="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <Border x:Name="SupplierPickerPanel" Padding="12" Margin="0,0,0,16" Background="#F7F9FB"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="AvailableSupplierComboBox" ItemsSource="{Binding AvailableSuppliers}" DisplayMemberPath="Name"
                          MinWidth="360" MinHeight="31" Padding="7,4" />
                <Button Content="Convidar" Click="AddSupplier_Click" Padding="12,6" Margin="8,0,0,0" Cursor="Hand" />
                <Button Content="Fechar" Click="CloseSupplierPicker_Click" Padding="12,6" Margin="8,0,0,0"
                        Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Cursor="Hand" />
              </StackPanel>
            </Border>

            <Border x:Name="NewQuotationPanel" Padding="14" Margin="0,0,0,16" Background="#F7F9FB"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="NewQuotationTitle" Text="Registrar resposta" FontSize="16" FontWeight="SemiBold" />
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Moeda" Foreground="{StaticResource Brush.Muted}"/><TextBox x:Name="NewQuotationCurrencyTextBox" MaxLength="3" Padding="7,4" /></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Referência" Foreground="{StaticResource Brush.Muted}"/><TextBox x:Name="NewQuotationReferenceTextBox" MaxLength="100" Padding="7,4" /></StackPanel>
                  <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Validade" Foreground="{StaticResource Brush.Muted}"/><DatePicker x:Name="NewQuotationValidUntilDatePicker" /></StackPanel>
                  <StackPanel Grid.Column="3"><TextBlock Text="Observação" Foreground="{StaticResource Brush.Muted}"/><TextBox x:Name="NewQuotationNotesTextBox" MaxLength="1000" Padding="7,4" /></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="Criar resposta" Click="CreateQuotation_Click" Padding="12,6" Cursor="Hand" />
                  <Button Content="Fechar" Click="CloseNewQuotation_Click" Padding="12,6" Margin="8,0,0,0"
                          Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Cursor="Hand" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="QuotationEditorPanel" Padding="14" Margin="0,0,0,16" Background="#F7F9FB"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5"
                    Visibility="{Binding HasCurrentSupplierQuotation, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Resposta do fornecedor" FontSize="17" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <TextBlock Text="Fornecedor: " Foreground="{StaticResource Brush.Muted}"/><TextBlock Text="{Binding CurrentSupplierQuotationSupplierName}" FontWeight="SemiBold"/>
                      <TextBlock Text="   Status: " Foreground="{StaticResource Brush.Muted}"/><TextBlock Text="{Binding CurrentSupplierQuotationStatusLabel}" FontWeight="SemiBold"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Finalizar resposta" Click="FinalizeQuotation_Click" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                            Visibility="{Binding CanEditCurrentSupplierQuotation, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Fechar editor" Click="CloseQuotationEditor_Click" Padding="12,6" Cursor="Hand"
                            Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Moeda" Foreground="{StaticResource Brush.Muted}"/><TextBox x:Name="QuotationCurrencyTextBox" MaxLength="3" Padding="7,4" /></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Referência" Foreground="{StaticResource Brush.Muted}"/><TextBox x:Name="QuotationReferenceTextBox" MaxLength="100" Padding="7,4" /></StackPanel>
                  <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Validade" Foreground="{StaticResource Brush.Muted}"/><DatePicker x:Name="QuotationValidUntilDatePicker" /></StackPanel>
                  <StackPanel Grid.Column="3"><TextBlock Text="Observação" Foreground="{StaticResource Brush.Muted}"/><TextBox x:Name="QuotationNotesTextBox" MaxLength="1000" Padding="7,4" /></StackPanel>
                </Grid>
                <Button Content="Salvar cabeçalho da resposta" Click="SaveQuotation_Click" Padding="12,6" HorizontalAlignment="Left" Margin="0,9,0,14" Cursor="Hand"
                        Visibility="{Binding CanEditCurrentSupplierQuotation, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="Linhas cotadas" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4">
                  <DataGrid ItemsSource="{Binding CurrentQuotationLines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                            RowHeaderWidth="0" BorderThickness="0" MinHeight="90" MaxHeight="220" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="#" Binding="{Binding SourceLineNumber}" Width="45" />
                      <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" MinWidth="190" />
                      <DataGridTextColumn Header="Preço unit." Binding="{Binding UnitPriceDisplay}" Width="105" />
                      <DataGridTextColumn Header="Entrega" Binding="{Binding PromisedDeliveryDateDisplay}" Width="100" />
                      <DataGridTextColumn Header="Obs." Binding="{Binding NotesDisplay}" Width="150" />
                      <DataGridTemplateColumn Header="Editar" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="Editar" Click="EditQuotationLine_Click" Padding="6,3" Cursor="Hand"
                                Visibility="{Binding DataContext.CanEditCurrentSupplierQuotation, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Remover" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="Remover" Click="RemoveQuotationLine_Click" Padding="6,3" Cursor="Hand"
                                Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                Visibility="{Binding DataContext.CanEditCurrentSupplierQuotation, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </Border>
                <Button Content="Adicionar linha cotada" Click="OpenAddQuotationLine_Click" Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,0" Cursor="Hand"
                        Visibility="{Binding CanEditCurrentSupplierQuotation, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Border x:Name="QuotationLineEditorPanel" Padding="12" Margin="0,10,0,0" Background="White"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock x:Name="QuotationLineEditorTitle" Text="Adicionar linha cotada" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="155"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Linha" Foreground="{StaticResource Brush.Muted}"/><ComboBox x:Name="QuotationLineSourceComboBox" ItemsSource="{Binding CurrentSourceLines}" DisplayMemberPath="SelectionDisplay" Padding="7,4" /></StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Preço unitário" Foreground="{StaticResource Brush.Muted}"/><TextBox x:Name="QuotationLinePriceTextBox" Padding="7,4" /></StackPanel>
                      <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Entrega prometida" Foreground="{StaticResource Brush.Muted}"/><DatePicker x:Name="QuotationLineDeliveryDatePicker" /></StackPanel>
                      <StackPanel Grid.Column="3"><TextBlock Text="Observação" Foreground="{StaticResource Brush.Muted}"/><TextBox x:Name="QuotationLineNotesTextBox" MaxLength="500" Padding="7,4" /></StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                      <Button Content="Salvar linha" Click="SaveQuotationLine_Click" Padding="12,6" Cursor="Hand" />
                      <Button Content="Fechar" Click="CloseQuotationLineEditor_Click" Padding="12,6" Margin="8,0,0,0"
                              Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Cursor="Hand" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border x:Name="CancellationPanel" Padding="14" Background="#FFF8EF" BorderBrush="#E5D2B7" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Cancelar cotação" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="A justificativa ficará preservada no documento." Foreground="{StaticResource Brush.Muted}" Margin="0,4,0,8" />
                <TextBox x:Name="CancellationReasonTextBox" MaxLength="500" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap" Padding="7,5" />
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                  <Button Content="Confirmar cancelamento" Click="ConfirmCancel_Click" Padding="12,6" Cursor="Hand" />
                  <Button Content="Fechar" Click="CloseCancel_Click" Padding="12,6" Margin="8,0,0,0"
                          Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Cursor="Hand" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
