<UserControl x:Class="LocalErp.Desktop.Views.PurchaseRequestsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid x:Name="WorkspaceContent" Margin="28,26" MaxWidth="1180" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Solicitações de compra" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="Primeiro fluxo operacional de Compras: rascunho, linhas, envio e cancelamento rastreável."
                     Foreground="{StaticResource Brush.Muted}" Margin="0,7,0,0" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Atualizar" Click="Refresh_Click" Padding="14,7" MinWidth="90"
                  Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                  BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
          <Button Content="Novo rascunho" Click="CreateDraft_Click" Padding="14,7" MinWidth="120" Margin="8,0,0,0" Cursor="Hand" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Margin="0,0,0,16" Padding="14" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Status" VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" Margin="0,0,10,0" />
          <ComboBox x:Name="StatusFilterComboBox" Grid.Column="1" ItemsSource="{Binding StatusFilters}"
                    DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                    SelectionChanged="StatusFilter_SelectionChanged" MinHeight="31" Padding="7,4" />
          <TextBlock Grid.Column="2" Text="O identificador técnico é um GUID; este slice ainda não cria numeração oficial de documento."
                     Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="2">
        <Border Margin="0,0,0,12" Padding="14,11" Background="#EEF5FC" BorderBrush="#C8DDF4"
                BorderThickness="1" CornerRadius="5" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="Carregando solicitações de compra..." Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border Margin="0,0,0,12" Padding="14,11" Background="#FFF4F2" BorderBrush="#E7C6C0"
                BorderThickness="1" CornerRadius="5" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border x:Name="OperationErrorPanel" Margin="0,0,0,12" Padding="12,9" Background="#FFF4F2"
                BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="OperationErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border x:Name="OperationSuccessPanel" Margin="0,0,0,12" Padding="12,9" Background="#E9F6EF"
                BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="OperationSuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
      </StackPanel>

      <Grid Grid.Row="3" Margin="0,0,0,20">
        <Border Padding="28" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="6" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Nenhuma solicitação encontrada" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Crie um rascunho ou altere o filtro de status." Margin="0,6,0,0"
                       HorizontalAlignment="Center" Foreground="{StaticResource Brush.Muted}" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="6" Visibility="{Binding HasRequests, Converter={StaticResource BoolToVisibilityConverter}}">
          <DataGrid ItemsSource="{Binding PurchaseRequests}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    BorderThickness="0" RowHeaderWidth="0" MinHeight="180" MaxHeight="300" SelectionMode="Single"
                    Background="Transparent" AlternatingRowBackground="#F8FAFC" HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                    VerticalGridLinesBrush="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Criada em" Binding="{Binding CreatedDisplay}" Width="150" />
              <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="110" />
              <DataGridTextColumn Header="Linhas" Binding="{Binding LineCount}" Width="70" />
              <DataGridTextColumn Header="Observação" Binding="{Binding NotesDisplay}" Width="*" MinWidth="260" />
              <DataGridTemplateColumn Header="Ação" Width="95">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Abrir" Click="OpenRequest_Click" Padding="10,5" MinWidth="70"
                            Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>

      <Border Grid.Row="4" Padding="18" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1" CornerRadius="6" Visibility="{Binding HasCurrentRequest, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Solicitação selecionada" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Status: " Foreground="{StaticResource Brush.Muted}" />
                <TextBlock Text="{Binding CurrentStatusLabel}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                <TextBlock Text="   Criada em: " Foreground="{StaticResource Brush.Muted}" />
                <TextBlock Text="{Binding CurrentCreatedDisplay}" Foreground="{StaticResource Brush.Text}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="ID técnico: " FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Brush.Muted}" />
                <TextBlock Text="{Binding CurrentIdDisplay}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Brush.Muted}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Content="Enviar" Click="Submit_Click" Padding="14,7" MinWidth="90" Margin="0,0,8,0" Cursor="Hand"
                      Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibilityConverter}}" />
              <Button Content="Cancelar solicitação" Click="OpenCancel_Click" Padding="14,7" MinWidth="135" Cursor="Hand"
                      Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                      Foreground="{StaticResource Brush.Text}"
                      Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </Grid>

          <Border Margin="0,0,0,16" Padding="12,9" Background="#EEF5FC" BorderBrush="#C8DDF4" BorderThickness="1" CornerRadius="5"
                  Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Esta solicitação não está mais em rascunho. O conteúdo é somente leitura; apenas o cancelamento permanece disponível quando aplicável."
                       TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
          </Border>

          <TextBlock Text="Observação" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,5" />
          <TextBox x:Name="NotesTextBox" Text="{Binding CurrentRequest.Notes, Mode=OneWay}" MaxLength="1000" MinHeight="66"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8,6"
                   IsReadOnly="{Binding IsReadOnly}" />
          <Button Content="Salvar observação" Click="SaveNotes_Click" Padding="12,6" MinWidth="120" HorizontalAlignment="Left"
                  Margin="0,9,0,18" Cursor="Hand" Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibilityConverter}}" />

          <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Linhas" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
            <Button Grid.Column="1" Content="Adicionar linha" Click="OpenAddLine_Click" Padding="12,6" MinWidth="105" Cursor="Hand"
                    Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibilityConverter}}" />
          </Grid>

          <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,14">
            <DataGrid ItemsSource="{Binding CurrentLines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeaderWidth="0" MinHeight="120" MaxHeight="300" Background="Transparent"
                      HorizontalGridLinesBrush="{StaticResource Brush.Border}" VerticalGridLinesBrush="Transparent">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="45" />
                <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" MinWidth="240" />
                <DataGridTextColumn Header="Quantidade" Binding="{Binding QuantityDisplay}" Width="95" />
                <DataGridTextColumn Header="Unidade" Binding="{Binding MeasurementUnitName}" Width="130" />
                <DataGridTextColumn Header="Necessidade" Binding="{Binding NeededByDateDisplay}" Width="110" />
                <DataGridTemplateColumn Header="Editar" Width="82">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Editar" Click="EditLine_Click" Padding="8,4" MinWidth="60" Cursor="Hand"
                              Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                              Visibility="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Remover" Width="88">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Remover" Click="RemoveLine_Click" Padding="8,4" MinWidth="64" Cursor="Hand"
                              Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                              Visibility="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <Border x:Name="LineEditorPanel" Padding="14" Margin="0,0,0,14" Background="#F7F9FB"
                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="LineEditorTitle" Text="Adicionar linha" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock Text="Descrição" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
                  <TextBox x:Name="LineDescriptionTextBox" MaxLength="500" MinHeight="31" Padding="7,4" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock Text="Quantidade" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
                  <TextBox x:Name="LineQuantityTextBox" MinHeight="31" Padding="7,4" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                  <TextBlock Text="Unidade" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
                  <ComboBox x:Name="LineUnitComboBox" ItemsSource="{Binding ActiveMeasurementUnits}" DisplayMemberPath="Name"
                            SelectedValuePath="Id" MinHeight="31" Padding="7,4" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                  <TextBlock Text="Data necessária" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
                  <DatePicker x:Name="LineNeededByDatePicker" MinHeight="31" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="SaveLineButton" Content="Salvar linha" Click="SaveLine_Click" Padding="12,6" MinWidth="100" Cursor="Hand" />
                <Button Content="Fechar" Click="CloseLineEditor_Click" Padding="12,6" MinWidth="80" Margin="8,0,0,0"
                        Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="CancellationPanel" Padding="14" Background="#FFF8E8" BorderBrush="#E3D3A5"
                  BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Cancelar solicitação" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
              <TextBlock Text="Informe a justificativa. O cancelamento é terminal neste primeiro slice e preserva a rastreabilidade."
                         Margin="0,4,0,8" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
              <TextBox x:Name="CancellationReasonTextBox" MaxLength="500" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" Padding="7,5" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Confirmar cancelamento" Click="ConfirmCancel_Click" Padding="12,6" MinWidth="145" Cursor="Hand" />
                <Button Content="Voltar" Click="CloseCancel_Click" Padding="12,6" MinWidth="75" Margin="8,0,0,0"
                        Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
