<UserControl x:Class="LocalErp.Desktop.Views.AdministrationUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,26" MaxWidth="1120" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Administração de usuários" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="Crie usuários, gerencie contas, redefina senhas, associe roles e administre o catálogo de roles/permissões. As salvaguardas continuam na camada de aplicação/persistência."
                     Foreground="{StaticResource Brush.Muted}" Margin="0,7,0,0" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Roles e permissões" Click="OpenRolesAdministration_Click" Padding="14,7" MinWidth="138"
                  Margin="0,0,8,0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                  BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
          <Button Content="Atualizar" Command="{Binding LoadCommand}" Padding="14,7" MinWidth="90"
                  Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                  BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Margin="0,0,0,18" Padding="16" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="Novo usuário" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="A senha é lida diretamente dos campos protegidos, enviada somente à camada de aplicação e limpa após a tentativa."
                     Margin="0,4,0,14" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="230" />
              <ColumnDefinition Width="210" />
              <ColumnDefinition Width="210" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="Usuário" Margin="0,0,0,5" Foreground="{StaticResource Brush.Muted}" />
              <TextBox x:Name="CreateUsernameTextBox" MaxLength="100" MinHeight="32" Padding="8,5" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="Senha" Margin="0,0,0,5" Foreground="{StaticResource Brush.Muted}" />
              <PasswordBox x:Name="CreatePasswordInput" MaxLength="128" MinHeight="32" Padding="8,5" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
              <TextBlock Text="Confirmar senha" Margin="0,0,0,5" Foreground="{StaticResource Brush.Muted}" />
              <PasswordBox x:Name="ConfirmPasswordInput" MaxLength="128" MinHeight="32" Padding="8,5"
                           KeyDown="ConfirmPasswordInput_KeyDown" />
            </StackPanel>
            <Button x:Name="CreateUserButton" Grid.Column="3" Content="Criar usuário" Click="CreateUser_Click"
                    MinWidth="116" MinHeight="32" Padding="14,6" Margin="0,22,0,0" VerticalAlignment="Top" Cursor="Hand" />
          </Grid>
          <TextBlock x:Name="PasswordPolicyText" Margin="0,8,0,0" Foreground="{StaticResource Brush.Muted}" />
          <Border x:Name="CreateErrorPanel" Margin="0,12,0,0" Padding="12,9" Background="#FFF4F2"
                  BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
            <TextBlock x:Name="CreateErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
          </Border>
          <Border x:Name="CreateSuccessPanel" Margin="0,12,0,0" Padding="12,9" Background="#E9F6EF"
                  BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
            <TextBlock x:Name="CreateSuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Margin="0,0,0,12" Padding="14,11" Background="#EEF5FC" BorderBrush="#C8DDF4"
              BorderThickness="1" CornerRadius="5" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="Carregando usuários..." Foreground="{StaticResource Brush.Text}" />
      </Border>
      <Border Grid.Row="3" Margin="0,0,0,12" Padding="14,11" Background="#FFF4F2" BorderBrush="#E7C6C0"
              BorderThickness="1" CornerRadius="5" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
      </Border>

      <StackPanel Grid.Row="4">
        <Border x:Name="StatusErrorPanel" Margin="0,0,0,12" Padding="12,9" Background="#FFF4F2"
                BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="StatusErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
        <Border x:Name="StatusSuccessPanel" Margin="0,0,0,12" Padding="12,9" Background="#E9F6EF"
                BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
          <TextBlock x:Name="StatusSuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
        </Border>
      </StackPanel>

      <Border x:Name="PasswordResetPanel" Grid.Row="5" Margin="0,0,0,18" Padding="16"
              Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="PasswordResetTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="Defina uma nova senha para a conta selecionada. A redefinição também remove tentativas falhas e bloqueio temporário de login, sem alterar se a conta está ativa ou inativa."
                     Margin="0,4,0,14" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="230" />
              <ColumnDefinition Width="230" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="Nova senha" Margin="0,0,0,5" Foreground="{StaticResource Brush.Muted}" />
              <PasswordBox x:Name="ResetPasswordInput" MaxLength="128" MinHeight="32" Padding="8,5" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="Confirmar nova senha" Margin="0,0,0,5" Foreground="{StaticResource Brush.Muted}" />
              <PasswordBox x:Name="ResetPasswordConfirmationInput" MaxLength="128" MinHeight="32" Padding="8,5"
                           KeyDown="ResetPasswordConfirmationInput_KeyDown" />
            </StackPanel>
            <Button x:Name="ResetPasswordConfirmButton" Grid.Column="2" Content="Redefinir senha"
                    Click="ResetPasswordConfirm_Click" MinWidth="122" MinHeight="32" Padding="14,6"
                    Margin="0,22,8,0" VerticalAlignment="Top" Cursor="Hand" />
            <Button x:Name="ResetPasswordCancelButton" Grid.Column="3" Content="Cancelar"
                    Click="ResetPasswordCancel_Click" MinWidth="88" MinHeight="32" Padding="14,6"
                    Margin="0,22,0,0" VerticalAlignment="Top" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
          </Grid>
          <TextBlock x:Name="ResetPasswordPolicyText" Margin="0,8,0,0" Foreground="{StaticResource Brush.Muted}" />
          <Border x:Name="ResetPasswordErrorPanel" Margin="0,12,0,0" Padding="12,9" Background="#FFF4F2"
                  BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
            <TextBlock x:Name="ResetPasswordErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
          </Border>
        </StackPanel>
      </Border>

      <Grid Grid.Row="6">
        <Border Padding="28" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="6" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Nenhum usuário encontrado" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Use o formulário acima para cadastrar o primeiro usuário desta lista." Margin="0,6,0,0"
                       HorizontalAlignment="Center" Foreground="{StaticResource Brush.Muted}" />
          </StackPanel>
        </Border>
        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="6" Visibility="{Binding HasUsers, Converter={StaticResource BoolToVisibilityConverter}}">
          <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    BorderThickness="0" RowHeaderWidth="0" MinHeight="220" MaxHeight="520" SelectionMode="Single"
                    Background="Transparent" AlternatingRowBackground="#F8FAFC" HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                    VerticalGridLinesBrush="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Usuário" Binding="{Binding Username}" Width="*" MinWidth="220" />
              <DataGridTemplateColumn Header="Status" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Padding="9,3" CornerRadius="10" HorizontalAlignment="Left">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#E9F6EF" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                              <Setter Property="Background" Value="#EEF1F4" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Conta" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="{Binding StatusAction}"
                            Click="ToggleUserStatus_Click"
                            Padding="11,5"
                            MinWidth="88"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            Foreground="{StaticResource Brush.Text}"
                            Cursor="Hand" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Senha" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Redefinir"
                            Click="OpenPasswordReset_Click"
                            Padding="11,5"
                            MinWidth="88"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            Foreground="{StaticResource Brush.Text}"
                            Cursor="Hand" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Roles" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Gerenciar"
                            Click="OpenRoleManagement_Click"
                            Padding="11,5"
                            MinWidth="88"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            Foreground="{StaticResource Brush.Text}"
                            Cursor="Hand" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
