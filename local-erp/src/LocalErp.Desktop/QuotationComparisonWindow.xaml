<Window x:Class="LocalErp.Desktop.QuotationComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comparar cotações"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Loaded="Window_Loaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="24,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Comparação de cotações"
                     FontSize="25"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="Comparação somente leitura das respostas registradas no RFQ. Nenhuma proposta é classificada ou escolhida automaticamente."
                     Margin="0,6,0,0"
                     Foreground="{StaticResource Brush.Muted}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
          <TextBlock Text="{Binding RfqStatusDisplay}"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="{Binding SummaryDisplay}"
                     Margin="0,5,0,0"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource Brush.Muted}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="24,16,24,0"
            Padding="12,9"
            Background="#EEF5FC"
            BorderBrush="#C8DDF4"
            BorderThickness="1"
            CornerRadius="5">
      <TextBlock Text="Preços em moedas diferentes são exibidos exatamente como registrados. Respostas em rascunho não entram na comparação de preços."
                 Foreground="{StaticResource Brush.Text}"
                 TextWrapping="Wrap" />
    </Border>

    <StackPanel Grid.Row="2" Margin="24,12,24,0">
      <Border x:Name="StatusPanel"
              Padding="12,9"
              Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1"
              CornerRadius="5">
        <TextBlock x:Name="StatusText"
                   Text="Carregando comparação..."
                   Foreground="{StaticResource Brush.Muted}" />
      </Border>
      <Border x:Name="ErrorPanel"
              Margin="0,8,0,0"
              Padding="12,9"
              Background="#FFF4F2"
              BorderBrush="#E7C6C0"
              BorderThickness="1"
              CornerRadius="5"
              Visibility="Collapsed">
        <TextBlock x:Name="ErrorText"
                   Foreground="{StaticResource Brush.Text}"
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <ScrollViewer x:Name="ComparisonContent"
                  Grid.Row="3"
                  Margin="24,14,24,16"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Visibility="Collapsed">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="330"
                  Margin="0,0,8,0"
                  Padding="14"
                  Background="#F7F9FB"
                  BorderBrush="{StaticResource Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="6">
            <StackPanel>
              <TextBlock Text="Linhas da solicitação"
                         FontWeight="SemiBold"
                         FontSize="15"
                         Foreground="{StaticResource Brush.Text}" />
              <TextBlock Text="Descrição, quantidade, unidade e data de necessidade."
                         Margin="0,5,0,0"
                         Foreground="{StaticResource Brush.Muted}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Suppliers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="240"
                        Margin="0,0,8,0"
                        Padding="14"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ResponseStatusDisplay}"
                               Margin="0,6,0,0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Primary}" />
                    <TextBlock Text="{Binding RegistrationStatusDisplay}"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource Brush.Muted}" />
                    <TextBlock Text="{Binding CurrencyDisplay}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding ReferenceDisplay}"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource Brush.Muted}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ValidityDisplay}"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource Brush.Muted}" />
                    <TextBlock Text="{Binding FinalizedDisplay}"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource Brush.Muted}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="330"
                        Margin="0,0,8,0"
                        Padding="14"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding QuantityDisplay}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding NeededByDisplay}"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource Brush.Muted}" />
                  </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="240"
                              Margin="0,0,8,0"
                              Padding="14"
                              Background="{StaticResource Brush.Surface}"
                              BorderBrush="{StaticResource Brush.Border}"
                              BorderThickness="1"
                              CornerRadius="6">
                        <StackPanel>
                          <TextBlock Text="{Binding PriceDisplay}"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource Brush.Text}" />
                          <TextBlock Text="{Binding AvailabilityDisplay}"
                                     Margin="0,5,0,0"
                                     Foreground="{StaticResource Brush.Primary}"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DeliveryDisplay}"
                                     Margin="0,8,0,0"
                                     Foreground="{StaticResource Brush.Muted}"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding NotesDisplay}"
                                     Margin="0,3,0,0"
                                     Foreground="{StaticResource Brush.Muted}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="4"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="24,12">
      <Button Content="Fechar"
              Click="Close_Click"
              HorizontalAlignment="Right"
              MinWidth="88"
              Padding="14,7"
              Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1"
              Cursor="Hand" />
    </Border>
  </Grid>
</Window>
