<Window x:Class="LocalErp.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrar — Local ERP"
        Width="860"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}">
      <Grid Margin="34">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="LOCAL ERP" Foreground="White" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Ambiente local" Foreground="#8FA4B8" Margin="0,5,0,0" FontSize="14" />
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBlock Text="Acesso seguro" Foreground="White" FontSize="27" FontWeight="SemiBold" />
          <TextBlock Text="Entre com sua conta local para acessar os módulos e permissões atribuídos ao seu usuário." Foreground="#C6D2DD" FontSize="14" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="21" />
          <Border Margin="0,24,0,0" Padding="14" Background="#1C2A36" CornerRadius="6">
            <StackPanel>
              <TextBlock Text="Sessão local" Foreground="#D7E0E8" FontWeight="SemiBold" />
              <TextBlock Text="A senha não é salva na sessão e não é registrada em logs." Foreground="#AFC0CF" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="19" />
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Offline-first • SQLite local" Foreground="#7F93A6" FontSize="12" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Background="White">
      <StackPanel Width="390" VerticalAlignment="Center">
        <TextBlock Text="Entrar no ERP" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
        <TextBlock Text="Use as credenciais cadastradas neste ambiente." Foreground="{StaticResource Brush.Muted}" Margin="0,7,0,26" />

        <TextBlock Text="Usuário" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,6" />
        <TextBox x:Name="UsernameTextBox" Height="40" Padding="10,7" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" FontSize="14" />

        <TextBlock Text="Senha" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,18,0,6" />
        <PasswordBox x:Name="PasswordInput" Height="40" Padding="10,7" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" FontSize="14" MaxLength="128" KeyDown="PasswordInput_KeyDown" />

        <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#FFF4F4" BorderBrush="#E4B4B4" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,16,0,0">
          <TextBlock x:Name="ErrorText" Foreground="#9B2C2C" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,24,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="CancelButton" Grid.Column="0" Content="Sair" Width="90" Height="38" HorizontalAlignment="Left" Click="Cancel_Click" />
          <Button x:Name="SignInButton" Grid.Column="1" Content="Entrar" Width="120" Height="38" Background="{StaticResource Brush.Primary}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="SignIn_Click" />
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
