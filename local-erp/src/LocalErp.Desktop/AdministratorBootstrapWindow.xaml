<Window x:Class="LocalErp.Desktop.AdministratorBootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração inicial — Local ERP"
        Width="900"
        Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}">
      <Grid Margin="34">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="LOCAL ERP" Foreground="White" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Configuração inicial" Foreground="#8FA4B8" Margin="0,5,0,0" FontSize="14" />
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBlock Text="Primeiro administrador" Foreground="White" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Esta conta terá acesso administrativo ao ambiente local. Não existe usuário ou senha padrão." Foreground="#C6D2DD" FontSize="14" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="21" />
          <Border Margin="0,24,0,0" Padding="14" Background="#1C2A36" CornerRadius="6">
            <TextBlock Text="O cadastro é gravado em uma única transação e só pode ser concluído uma vez." Foreground="#AFC0CF" TextWrapping="Wrap" LineHeight="19" />
          </Border>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Dados armazenados somente neste ambiente" Foreground="#7F93A6" FontSize="12" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Background="White">
      <StackPanel Width="430" VerticalAlignment="Center">
        <TextBlock Text="Criar conta administrativa" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
        <TextBlock Text="Defina as credenciais que serão usadas para entrar no ERP." Foreground="{StaticResource Brush.Muted}" Margin="0,7,0,24" />

        <TextBlock Text="Usuário" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,6" />
        <TextBox x:Name="UsernameTextBox" Height="40" Padding="10,7" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" FontSize="14" />

        <TextBlock Text="Senha" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,18,0,6" />
        <PasswordBox x:Name="PasswordInput" Height="40" Padding="10,7" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" FontSize="14" MaxLength="128" />
        <TextBlock Text="Use de 15 a 128 caracteres. Não há exigência artificial de símbolos ou maiúsculas." Foreground="{StaticResource Brush.Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Confirmar senha" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,18,0,6" />
        <PasswordBox x:Name="ConfirmPasswordInput" Height="40" Padding="10,7" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" FontSize="14" MaxLength="128" />

        <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#FFF4F4" BorderBrush="#E4B4B4" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,16,0,0">
          <TextBlock x:Name="ErrorText" Foreground="#9B2C2C" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,22,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="CancelButton" Grid.Column="0" Content="Sair" Width="94" Height="38" HorizontalAlignment="Left" Click="Cancel_Click" />
          <Button x:Name="CreateButton" Grid.Column="1" Content="Criar administrador" Width="165" Height="38" Background="{StaticResource Brush.Primary}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="CreateAdministrator_Click" />
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
