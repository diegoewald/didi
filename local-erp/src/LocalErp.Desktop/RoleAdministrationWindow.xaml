<Window x:Class="LocalErp.Desktop.RoleAdministrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roles e permissões — Local ERP"
        Width="1080"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Loaded="Window_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Roles e permissões" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
        <TextBlock Text="Crie roles, altere seu status e administre as permissões registradas no catálogo do ERP."
                   Margin="0,6,0,0" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="Atualizar" Click="Refresh_Click"
              MinWidth="92" Padding="14,7" VerticalAlignment="Top"
              Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
    </Grid>

    <Border Grid.Row="1" Margin="0,0,0,14" Padding="12,10" Background="#EEF5FC"
            BorderBrush="#C8DDF4" BorderThickness="1" CornerRadius="5">
      <TextBlock Text="Proteção administrativa: desativar uma role ou revogar roles.manage é bloqueado quando isso eliminaria a última capacidade efetiva de administrar roles. A validação e a auditoria são atômicas na persistência."
                 Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Margin="0,0,0,14" Padding="14" Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
          <TextBlock Text="Nova role" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,5" />
          <TextBox x:Name="CreateRoleNameTextBox" MaxLength="100" MinHeight="32" Padding="8,5"
                   KeyDown="CreateRoleNameTextBox_KeyDown" />
        </StackPanel>
        <Button x:Name="CreateRoleButton" Grid.Column="1" Content="Criar role" Click="CreateRole_Click"
                MinWidth="100" MinHeight="32" Padding="14,6" Margin="0,22,14,0"
                VerticalAlignment="Top" Cursor="Hand" />
        <TextBlock Grid.Column="2" Text="Nomes são normalizados para unicidade. A role nasce ativa e sem permissões."
                   VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="3">
      <Border x:Name="ErrorPanel" Margin="0,0,0,12" Padding="12,9" Background="#FFF4F2"
              BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
      </Border>
      <Border x:Name="SuccessPanel" Margin="0,0,0,12" Padding="12,9" Background="#E9F6EF"
              BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
        <TextBlock x:Name="SuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="0.85*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1" CornerRadius="6" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Margin="16,14,16,10">
            <TextBlock Text="Roles cadastradas" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
            <TextBlock x:Name="RoleListStatusText" Margin="0,4,0,0" Foreground="{StaticResource Brush.Muted}" />
          </StackPanel>
          <DataGrid x:Name="RolesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0"
                    SelectionMode="Single" SelectionChanged="RolesGrid_SelectionChanged"
                    Background="Transparent" AlternatingRowBackground="#F8FAFC"
                    HorizontalGridLinesBrush="{StaticResource Brush.Border}" VerticalGridLinesBrush="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="*" MinWidth="180" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" />
              <DataGridTextColumn Header="Permissões" Binding="{Binding PermissionCount}" Width="85" />
              <DataGridTemplateColumn Header="Ação" Width="105">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="{Binding StatusAction}" Click="ToggleRoleStatus_Click"
                            Padding="9,4" MinWidth="78" Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1" CornerRadius="6" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Margin="16,14,16,10">
            <TextBlock x:Name="SelectedRoleTitle" Text="Permissões" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock x:Name="SelectedRoleSubtitle" Text="Selecione uma role para administrar suas permissões."
                       Margin="0,4,0,0" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Row="1">
            <TextBlock x:Name="NoRoleSelectedText" Text="Nenhuma role selecionada."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" />
            <DataGrid x:Name="PermissionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0"
                      Visibility="Collapsed" Background="Transparent" AlternatingRowBackground="#F8FAFC"
                      HorizontalGridLinesBrush="{StaticResource Brush.Border}" VerticalGridLinesBrush="Transparent">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Permissão" Binding="{Binding Code}" Width="*" MinWidth="180" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105" />
                <DataGridTemplateColumn Header="Ação" Width="105">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="{Binding ActionLabel}" Click="TogglePermission_Click"
                              Padding="9,4" MinWidth="78" Background="{StaticResource Brush.Surface}"
                              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                              Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="5" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Concessões e revogações exigem roles.manage. Reduções de privilégio pedem confirmação e continuam sujeitas às salvaguardas da camada de aplicação/persistência."
                 VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,18,0" />
      <Button x:Name="CloseButton" Grid.Column="1" Content="Fechar" Click="Close_Click"
              MinWidth="92" Padding="14,7" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
              Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
    </Grid>
  </Grid>
</Window>
