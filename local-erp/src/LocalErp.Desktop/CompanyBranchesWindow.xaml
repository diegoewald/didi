<Window x:Class="LocalErp.Desktop.CompanyBranchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filiais"
        Width="850"
        Height="650"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Loaded="Window_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
        <TextBlock Text="Filiais pertencem à empresa selecionada. Nome e status são mantidos sem presumir regras fiscais, endereço ou matriz."
                   Margin="0,6,18,0" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="Atualizar" Click="Refresh_Click"
              Padding="14,7" MinWidth="90" VerticalAlignment="Top"
              Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
    </Grid>

    <Border Grid.Row="1" Padding="15" Margin="0,0,0,14" Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
          <TextBlock Text="Nova filial" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
          <TextBox x:Name="CreateNameTextBox" MaxLength="200" MinHeight="32" Padding="8,5" Margin="0,8,0,0"
                   KeyDown="CreateNameTextBox_KeyDown" />
        </StackPanel>
        <Button x:Name="CreateButton" Grid.Column="1" Content="Criar filial" Click="Create_Click"
                MinWidth="110" MinHeight="32" Padding="14,6" Margin="0,30,0,0" VerticalAlignment="Top" Cursor="Hand" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="2">
      <Border x:Name="ErrorPanel" Margin="0,0,0,10" Padding="12,9" Background="#FFF4F2"
              BorderBrush="#E7C6C0" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
      </Border>
      <Border x:Name="SuccessPanel" Margin="0,0,0,10" Padding="12,9" Background="#E9F6EF"
              BorderBrush="#BFDCCB" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
        <TextBlock x:Name="SuccessText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
      </Border>
    </StackPanel>

    <Border x:Name="RenamePanel" Grid.Row="3" Padding="15" Margin="0,0,0,14" Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="RenameTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="RenameTextBox" Grid.Column="0" MaxLength="200" MinHeight="32" Padding="8,5" Margin="0,0,10,0"
                   KeyDown="RenameTextBox_KeyDown" />
          <Button x:Name="RenameSaveButton" Grid.Column="1" Content="Salvar" Click="RenameSave_Click"
                  MinWidth="85" Padding="13,6" Margin="0,0,8,0" Cursor="Hand" />
          <Button x:Name="RenameCancelButton" Grid.Column="2" Content="Cancelar" Click="RenameCancel_Click"
                  MinWidth="85" Padding="13,6" Background="{StaticResource Brush.Surface}"
                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <TextBlock x:Name="EmptyText" Text="Nenhuma filial cadastrada para esta empresa."
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}"
                   FontSize="15" Visibility="Collapsed" />
        <DataGrid x:Name="BranchesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single" Background="Transparent"
                  AlternatingRowBackground="#F8FAFC" HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                  VerticalGridLinesBrush="Transparent">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Filial" Binding="{Binding Name}" Width="*" MinWidth="260" />
            <DataGridTemplateColumn Header="Status" Width="115">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Padding="9,3" CornerRadius="10" HorizontalAlignment="Left">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#E9F6EF" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Background" Value="#EEF1F4" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Nome" Width="115">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Renomear" Click="OpenRename_Click" Padding="10,5" MinWidth="82"
                          Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Situação" Width="115">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="{Binding StatusAction}" Click="ToggleStatus_Click" Padding="10,5" MinWidth="82"
                          Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Grid Grid.Row="5" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" />
      <Button x:Name="CloseButton" Grid.Column="1" Content="Fechar" Click="Close_Click" MinWidth="88" Padding="14,7"
              Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1" Foreground="{StaticResource Brush.Text}" Cursor="Hand" />
    </Grid>
  </Grid>
</Window>
