<Window x:Class="LocalErp.Desktop.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alterar senha — Local ERP"
        Width="520"
        Height="500"
        MinWidth="480"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Window}">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Alterar minha senha"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource Brush.Text}" />
      <TextBlock Text="Confirme sua senha atual e defina uma nova senha para esta conta."
                 Margin="0,6,0,0"
                 Foreground="{StaticResource Brush.Muted}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,14">
      <TextBlock Text="Senha atual" Margin="0,0,0,5" Foreground="{StaticResource Brush.Muted}" />
      <PasswordBox x:Name="CurrentPasswordInput" MaxLength="128" MinHeight="34" Padding="9,6" />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,14">
      <TextBlock Text="Nova senha" Margin="0,0,0,5" Foreground="{StaticResource Brush.Muted}" />
      <PasswordBox x:Name="NewPasswordInput" MaxLength="128" MinHeight="34" Padding="9,6" />
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,0,0,10">
      <TextBlock Text="Confirmar nova senha" Margin="0,0,0,5" Foreground="{StaticResource Brush.Muted}" />
      <PasswordBox x:Name="ConfirmNewPasswordInput"
                   MaxLength="128"
                   MinHeight="34"
                   Padding="9,6"
                   KeyDown="ConfirmNewPasswordInput_KeyDown" />
      <TextBlock x:Name="PasswordPolicyText"
                 Margin="0,8,0,0"
                 Foreground="{StaticResource Brush.Muted}" />
    </StackPanel>

    <Border Grid.Row="4"
            x:Name="ErrorPanel"
            Margin="0,4,0,14"
            Padding="12,9"
            Background="#FFF4F2"
            BorderBrush="#E7C6C0"
            BorderThickness="1"
            CornerRadius="5"
            Visibility="Collapsed">
      <TextBlock x:Name="ErrorText"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.Text}" />
    </Border>

    <Border Grid.Row="5"
            Margin="0,0,0,18"
            Padding="12,10"
            Background="#EEF5FC"
            BorderBrush="#C8DDF4"
            BorderThickness="1"
            CornerRadius="5">
      <TextBlock Text="A senha atual e a nova senha existem apenas nos campos protegidos desta janela. Elas não são registradas em logs, sessão ou auditoria."
                 TextWrapping="Wrap"
                 Foreground="{StaticResource Brush.Text}" />
    </Border>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton"
              Content="Cancelar"
              Click="Cancel_Click"
              MinWidth="92"
              Padding="14,7"
              Margin="0,0,10,0"
              Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="1"
              Foreground="{StaticResource Brush.Text}"
              Cursor="Hand" />
      <Button x:Name="ChangePasswordButton"
              Content="Alterar senha"
              Click="ChangePassword_Click"
              MinWidth="112"
              Padding="14,7"
              Cursor="Hand" />
    </StackPanel>
  </Grid>
</Window>
